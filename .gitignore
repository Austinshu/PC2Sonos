# Build artifacts and caches -- not source
__pycache__/
build/
*.pyc

# Compiled binaries -- distributed via GitHub Releases, not committed here
*.exe

# Third-party VB-CABLE driver payload -- bundled at build time by
# build_installer.ps1, not our source (see README's Credits section)
payload/

# Local build/install logs -- machine-specific, not useful to anyone else
install-log.txt
installer-build-log.txt

# Dashboard password -- lives in %ProgramData%\PC2Sonos at runtime, never
# in the repo; ignored here too so a dev-time copy can't be committed
dashboard_password.txt
